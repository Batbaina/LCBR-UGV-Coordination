# Build artifacts
build/
build_debug/
build_asan/
*.o
*.a

# Original Wen benchmark: thousands of files, publicly available upstream
# -- clone it locally rather than committing a copy (see benchmark/README.md).
benchmark/*
!benchmark/README.md

# Generated raw outputs -- one folder per run_id, reproducible from
# config/experiments/*.yaml + the benchmark, not meant to be versioned.
runs/*
!runs/.gitkeep
!runs/README.md

# Selected-instance lists are derived from config/experiments/*.yaml +
# whatever benchmark/ happens to contain locally -- regenerate with
# select_instances.py / select_conflict_instances.py rather than
# committing a stale snapshot.
experiments/*/selected_instances*.txt

# results/ (tables, figures) is regenerated by analysis/*.py and
# analysis.ipynb from runs/ -- not committed, except the one pipeline
# image kept under docs/images/ for the README.
results/tables/*
results/figures/*
!results/tables/.gitkeep
!results/figures/.gitkeep

# Jupyter checkpoints
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor/OS noise
.vscode/
.idea/
*.swp
.DS_Store
