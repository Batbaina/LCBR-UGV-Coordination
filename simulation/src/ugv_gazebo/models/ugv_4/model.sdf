<?xml version="1.0"?>
<sdf version="1.10">

  <model name="ugv_4">

    <!-- ===================================================== -->
    <!-- REFERENCE CONVENTION                                  -->
    <!-- Model x=y=0 is the REAR AXLE CENTER, matching the     -->
    <!-- SHA*/LCBR State(x,y,yaw) reference. Front axle x=1.3. -->
    <!-- Planner footprint spans x=[-1,+2], y=[-1,+1].         -->
    <!-- ===================================================== -->

    <!-- ===================================================== -->
    <!-- CHASSIS -->
    <!-- ===================================================== -->
    <link name="base_link">
      <pose>0 0 0.35 0 0 0</pose>

      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>1.8</ixx>
          <iyy>3.0</iyy>
          <izz>3.5</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <!-- Planner footprint: rear axle reference, LB=1 m, LF=2 m. -->
        <pose>0.5 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.0 2.0 0.35</size>
          </box>
        </geometry>
      </collision>

      <!-- ================================================= -->
      <!-- REALISTIC VISUAL BODY ONLY                         -->
      <!-- Physics, collision and Ackermann model unchanged. -->
      <!-- ================================================= -->

      <!-- Structural lower chassis -->
      <visual name="lower_chassis">
        <pose>0.45 0 0.18 0 0 0</pose>
        <geometry>
          <box>
            <size>2.65 1.55 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.035 0.045 0.055 1</ambient>
          <diffuse>0.055 0.065 0.075 1</diffuse>
        </material>
      </visual>

      <!-- Main body -->
      <visual name="main_body">
        <pose>0.40 0 0.39 0 0 0</pose>
        <geometry>
          <box>
            <size>2.25 1.38 0.32</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.28 0.62 1</ambient>
          <diffuse>0.08 0.40 0.88 1</diffuse>
        </material>
      </visual>

      <!-- Raised central electronics enclosure -->
      <visual name="electronics_enclosure">
        <pose>0.25 0 0.65 0 0 0</pose>
        <geometry>
          <box>
            <size>1.20 1.02 0.25</size>
          </box>
        </geometry>
        <material>
          <ambient>0.07 0.24 0.50 1</ambient>
          <diffuse>0.10 0.34 0.72 1</diffuse>
        </material>
      </visual>

      <!-- Sloped-looking front hood -->
      <visual name="front_hood">
        <pose>1.30 0 0.52 0 -0.12 0</pose>
        <geometry>
          <box>
            <size>0.72 1.25 0.27</size>
          </box>
        </geometry>
        <material>
          <ambient>0.06 0.30 0.65 1</ambient>
          <diffuse>0.09 0.43 0.92 1</diffuse>
        </material>
      </visual>

      <!-- Rear equipment platform -->
      <visual name="rear_platform">
        <pose>-0.55 0 0.51 0 0 0</pose>
        <geometry>
          <box>
            <size>0.58 1.18 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.10 0.11 0.12 1</ambient>
          <diffuse>0.16 0.17 0.18 1</diffuse>
        </material>
      </visual>

      <!-- Front bumper -->
      <visual name="front_bumper">
        <pose>1.78 0 0.22 0 0 0</pose>
        <geometry>
          <box>
            <size>0.13 1.72 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.025 0.025 0.025 1</ambient>
          <diffuse>0.055 0.055 0.055 1</diffuse>
        </material>
      </visual>

      <!-- Rear bumper -->
      <visual name="rear_bumper">
        <pose>-0.82 0 0.22 0 0 0</pose>
        <geometry>
          <box>
            <size>0.13 1.72 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.025 0.025 0.025 1</ambient>
          <diffuse>0.055 0.055 0.055 1</diffuse>
        </material>
      </visual>

      <!-- Left protective side rail -->
      <visual name="left_side_rail">
        <pose>0.45 0.83 0.31 0 0 0</pose>
        <geometry>
          <box>
            <size>2.35 0.07 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>

      <!-- Right protective side rail -->
      <visual name="right_side_rail">
        <pose>0.45 -0.83 0.31 0 0 0</pose>
        <geometry>
          <box>
            <size>2.35 0.07 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>

      <!-- Sensor mast -->
      <visual name="sensor_mast">
        <pose>0.25 0 0.97 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.52</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.14 0.14 0.14 1</diffuse>
        </material>
      </visual>

      <!-- LiDAR lower housing -->
      <visual name="lidar_base">
        <pose>0.25 0 1.22 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.07 0.07 0.07 1</diffuse>
        </material>
      </visual>

      <!-- LiDAR scanning head -->
      <visual name="lidar_head">
        <pose>0.25 0 1.30 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.125</radius>
            <length>0.09</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
        </material>
      </visual>

      <!-- Front camera housing -->
      <visual name="camera_body">
        <pose>1.58 0 0.70 0 0 0</pose>
        <geometry>
          <box>
            <size>0.14 0.30 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.025 0.025 0.025 1</ambient>
          <diffuse>0.06 0.06 0.06 1</diffuse>
        </material>
      </visual>

      <!-- Camera lens -->
      <visual name="camera_lens">
        <pose>1.66 0 0.70 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.01 0.03 0.05 1</ambient>
          <diffuse>0.02 0.08 0.14 1</diffuse>
        </material>
      </visual>

      <!-- Left headlight -->
      <visual name="left_headlight">
        <pose>1.73 0.43 0.48 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.90 0.55 1</ambient>
          <diffuse>1.0 0.95 0.65 1</diffuse>
          <emissive>0.65 0.55 0.20 1</emissive>
        </material>
      </visual>

      <!-- Right headlight -->
      <visual name="right_headlight">
        <pose>1.73 -0.43 0.48 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.90 0.55 1</ambient>
          <diffuse>1.0 0.95 0.65 1</diffuse>
          <emissive>0.65 0.55 0.20 1</emissive>
        </material>
      </visual>

      <!-- Left rear light -->
      <visual name="left_rear_light">
        <pose>-0.86 0.43 0.43 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.70 0.02 0.02 1</ambient>
          <diffuse>0.95 0.03 0.03 1</diffuse>
          <emissive>0.35 0.00 0.00 1</emissive>
        </material>
      </visual>

      <!-- Right rear light -->
      <visual name="right_rear_light">
        <pose>-0.86 -0.43 0.43 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.70 0.02 0.02 1</ambient>
          <diffuse>0.95 0.03 0.03 1</diffuse>
          <emissive>0.35 0.00 0.00 1</emissive>
        </material>
      </visual>

      <!-- Left antenna -->
      <visual name="left_antenna">
        <pose>-0.20 0.28 1.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.55</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <!-- Right antenna -->
      <visual name="right_antenna">
        <pose>-0.20 -0.28 1.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.55</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>


    <!-- ===================================================== -->
    <!-- FRONT STEERING LINKS -->
    <!-- ===================================================== -->

    <link name="front_left_steering_link">
      <pose>1.30 0.58 0.25 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="front_right_steering_link">
      <pose>1.30 -0.58 0.25 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>


    <!-- ===================================================== -->
    <!-- FRONT LEFT WHEEL -->
    <!-- Link frame stays aligned with vehicle. -->
    <!-- Cylinder geometry is rotated so axle is along Y. -->
    <!-- ===================================================== -->

    <link name="front_left_wheel">
      <pose>1.30 0.58 0.25 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.02</iyy>
          <izz>0.03</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>

        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>

        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    
      <visual name="rim_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.13</radius>
            <length>0.175</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.37 1</ambient>
          <diffuse>0.60 0.60 0.64 1</diffuse>
        </material>
      </visual>

</link>


    <!-- ===================================================== -->
    <!-- FRONT RIGHT WHEEL -->
    <!-- ===================================================== -->

    <link name="front_right_wheel">
      <pose>1.30 -0.58 0.25 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.02</iyy>
          <izz>0.03</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>

        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>

        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    
      <visual name="rim_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.13</radius>
            <length>0.175</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.37 1</ambient>
          <diffuse>0.60 0.60 0.64 1</diffuse>
        </material>
      </visual>

</link>


    <!-- ===================================================== -->
    <!-- REAR LEFT WHEEL -->
    <!-- ===================================================== -->

    <link name="rear_left_wheel">
      <pose>0.0 0.58 0.25 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.02</iyy>
          <izz>0.03</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>

        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>

        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    
      <visual name="rim_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.13</radius>
            <length>0.175</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.37 1</ambient>
          <diffuse>0.60 0.60 0.64 1</diffuse>
        </material>
      </visual>

</link>


    <!-- ===================================================== -->
    <!-- REAR RIGHT WHEEL -->
    <!-- ===================================================== -->

    <link name="rear_right_wheel">
      <pose>0.0 -0.58 0.25 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.02</iyy>
          <izz>0.03</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>

        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>

        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    
      <visual name="rim_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.13</radius>
            <length>0.175</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.37 1</ambient>
          <diffuse>0.60 0.60 0.64 1</diffuse>
        </material>
      </visual>

</link>


    <!-- ===================================================== -->
    <!-- STEERING JOINTS : rotation around Z -->
    <!-- ===================================================== -->

    <joint name="front_left_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_steering_link</child>

      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.60</lower>
          <upper>0.60</upper>
          <effort>100</effort>
          <velocity>2.0</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="front_right_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_steering_link</child>

      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.60</lower>
          <upper>0.60</upper>
          <effort>100</effort>
          <velocity>2.0</velocity>
        </limit>
      </axis>
    </joint>


    <!-- ===================================================== -->
    <!-- FRONT WHEEL ROLLING JOINTS : rotation around Y -->
    <!-- ===================================================== -->

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>


    <!-- ===================================================== -->
    <!-- REAR DRIVEN WHEELS : rotation around Y -->
    <!-- ===================================================== -->

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>


    <!-- ===================================================== -->
    <!-- ACKERMANN STEERING SYSTEM -->
    <!-- ===================================================== -->

    <plugin
      filename="gz-sim-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">

      <left_steering_joint>
        front_left_steering_joint
      </left_steering_joint>

      <right_steering_joint>
        front_right_steering_joint
      </right_steering_joint>

      <left_joint>
        rear_left_wheel_joint
      </left_joint>

      <right_joint>
        rear_right_wheel_joint
      </right_joint>

      <wheel_base>1.30</wheel_base>
      <wheel_separation>1.16</wheel_separation>
      <wheel_radius>0.25</wheel_radius>

      <min_velocity>-2.0</min_velocity>
      <max_velocity>2.0</max_velocity>

      <min_acceleration>-1.0</min_acceleration>
      <max_acceleration>1.0</max_acceleration>

      <!-- Match SHA* minimum turning radius R = 3.0 m.
           Gazebo AckermannSteering:
           steering_limit = asin(wheel_base / turning_radius)
                          = asin(1.30 / 3.0)
                          ~= 0.448 rad. -->
      <steering_limit>0.448</steering_limit>
      <steer_p_gain>8.0</steer_p_gain>

      <topic>/ugv_4/cmd_vel</topic>

    </plugin>

  </model>

</sdf>
